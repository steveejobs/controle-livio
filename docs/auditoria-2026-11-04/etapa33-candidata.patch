+BEGIN;
+-- Preserve SELECT/RLS, server privileges, Auth lifecycle and integrity triggers.
+-- Financial evidence in Storage gains a write-only guard below.
+DO $security$
+DECLARE t text; c record; r text;
+BEGIN
+ FOREACH t IN ARRAY ARRAY['contracts','receivables','receivable_installments','payments','payment_allocations','payment_reversals','payment_change_requests','financial_adjustments','renegotiations','expenses','payment_receipts','audit_logs',
+ -- Dependencies: admin-only identity/configuration and financial document evidence.
+ 'organizations','users','roles','permissions','role_permissions','user_roles',
+ 'organization_members','organization_member_roles','documents','document_versions'] LOOP
+  IF to_regclass('public.' || t) IS NULL THEN RAISE EXCEPTION 'Missing relation: %', t; END IF;
+  IF NOT EXISTS (SELECT 1 FROM pg_class WHERE oid=to_regclass('public.'||t) AND relkind='r' AND relrowsecurity AND relforcerowsecurity) THEN
+   RAISE EXCEPTION 'Expected ordinary FORCE RLS table: %',t;
+  END IF;
+  EXECUTE format('REVOKE INSERT, UPDATE, DELETE ON public.%I FROM PUBLIC, anon, authenticated', t);
+  FOR c IN SELECT attname FROM pg_attribute WHERE attrelid=to_regclass('public.' || t) AND attnum>0 AND NOT attisdropped LOOP
+   EXECUTE format('REVOKE INSERT (%I), UPDATE (%I) ON public.%I FROM PUBLIC, anon, authenticated', c.attname,c.attname,t);
+  END LOOP;
+  EXECUTE format('CREATE POLICY financial_api_insert ON public.%I AS RESTRICTIVE FOR INSERT TO anon, authenticated WITH CHECK (false)',t);
+  EXECUTE format('CREATE POLICY financial_api_update ON public.%I AS RESTRICTIVE FOR UPDATE TO anon, authenticated USING (false) WITH CHECK (false)',t);
+  EXECUTE format('CREATE POLICY financial_api_delete ON public.%I AS RESTRICTIVE FOR DELETE TO anon, authenticated USING (false)',t);
+  FOREACH r IN ARRAY ARRAY['anon','authenticated'] LOOP
+   IF EXISTS (SELECT 1 FROM pg_roles WHERE (rolsuper OR rolbypassrls) AND pg_has_role(r,oid,'SET')) THEN RAISE EXCEPTION 'Unsafe client role: %',r; END IF;
+   IF has_table_privilege(r,'public.'||t,'INSERT,UPDATE,DELETE') OR has_any_column_privilege(r,'public.'||t,'INSERT,UPDATE') THEN
+    RAISE EXCEPTION 'Inherited write privilege: % on %; inspect memberships',r,t;
+   END IF;
+  END LOOP;
+ END LOOP;
+END;
+$security$;
+-- RI cascades can modify financial children without a direct child DML grant.
+-- Client/matter edits remain available; identity and tenant are never editable.
+CREATE FUNCTION public.protect_financial_parent_identity() RETURNS trigger
+LANGUAGE plpgsql SET search_path = pg_catalog AS $identity$
+BEGIN
+ IF (NEW.id,NEW.organization_id) IS DISTINCT FROM (OLD.id,OLD.organization_id) THEN
+  RAISE EXCEPTION 'Financial parent identity and organization are immutable' USING ERRCODE='23514';
+ END IF;
+ RETURN NEW;
+END;
+$identity$;
+REVOKE ALL ON FUNCTION public.protect_financial_parent_identity() FROM PUBLIC, anon, authenticated;
+CREATE TRIGGER protect_financial_client_identity BEFORE UPDATE OF id,organization_id ON public.clients
+ FOR EACH ROW EXECUTE FUNCTION public.protect_financial_parent_identity();
+CREATE TRIGGER protect_financial_matter_identity BEFORE UPDATE OF id,organization_id ON public.matters
+ FOR EACH ROW EXECUTE FUNCTION public.protect_financial_parent_identity();
+-- Read-only helper: RLS on receipts must not hide evidence linkage from this guard.
+CREATE FUNCTION public.is_financial_storage_object(object_name text) RETURNS boolean
+LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog
+AS $evidence$
+ SELECT EXISTS (
+  SELECT 1 FROM public.document_versions v JOIN public.documents d ON d.id=v.document_id
+  WHERE v.storage_key=object_name AND (
+   d.installment_id IS NOT NULL OR d.payment_id IS NOT NULL OR d.expense_id IS NOT NULL
+   OR d.contract_id IS NOT NULL
+   OR EXISTS (SELECT 1 FROM public.payment_receipts r WHERE r.document_id=d.id)
+  )
+ )
+$evidence$;
+REVOKE ALL ON FUNCTION public.is_financial_storage_object(text) FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.is_financial_storage_object(text) TO authenticated;
+CREATE POLICY financial_evidence_update ON storage.objects AS RESTRICTIVE FOR UPDATE TO authenticated
+ USING (bucket_id <> 'legal-documents' OR NOT public.is_financial_storage_object(name))
+ WITH CHECK (bucket_id <> 'legal-documents' OR NOT public.is_financial_storage_object(name));
+CREATE POLICY financial_evidence_delete ON storage.objects AS RESTRICTIVE FOR DELETE TO authenticated
+ USING (bucket_id <> 'legal-documents' OR NOT public.is_financial_storage_object(name));
+COMMIT;
diff --git a/tools/qa/financial-security-inspect.sql b/tools/qa/financial-security-inspect.sql
new file mode 100644
--- /dev/null
+++ b/tools/qa/financial-security-inspect.sql
@@ -0,0 +1,25 @@
+-- Read-only preflight AND postcheck. Capture before/after in disposable CI.
+SELECT current_user, session_user, version();
+SELECT rolname, rolsuper, rolbypassrls, rolinherit FROM pg_roles;
+SELECT * FROM pg_auth_members;
+SELECT * FROM information_schema.table_privileges WHERE table_schema='public';
+SELECT * FROM information_schema.column_privileges WHERE table_schema='public';
+SELECT * FROM pg_default_acl;
+SELECT * FROM pg_policies WHERE schemaname IN ('public','storage');
+SELECT n.nspname,c.relname,c.relkind,c.relrowsecurity,c.relforcerowsecurity,c.relacl
+FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public';
+SELECT * FROM pg_views WHERE schemaname='public';
+SELECT p.oid::regprocedure,p.prosecdef,p.proacl,p.proconfig,pg_get_functiondef(p.oid)
+FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='public' AND p.prokind='f';
+SELECT tgrelid::regclass,tgname,tgenabled,pg_get_triggerdef(oid) FROM pg_trigger WHERE NOT tgisinternal;
+SELECT conrelid::regclass,conname,pg_get_constraintdef(oid) FROM pg_constraint WHERE connamespace='public'::regnamespace;
+
+-- Explicit PUBLIC ACLs (grantee zero), column ACLs, and SET ROLE paths.
+SELECT c.oid::regclass::text AS relation,a.grantee,a.privilege_type,a.is_grantable
+FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
+CROSS JOIN LATERAL aclexplode(coalesce(c.relacl,acldefault('r',c.relowner))) a
+WHERE n.nspname='public';
+SELECT attrelid::regclass::text,attname,attacl::text FROM pg_attribute
+WHERE attacl IS NOT NULL AND attrelid IN (SELECT oid FROM pg_class WHERE relnamespace='public'::regnamespace);
+SELECT c.rolname AS client,p.rolname AS reachable_bypass FROM pg_roles c CROSS JOIN pg_roles p
+WHERE c.rolname IN ('anon','authenticated') AND (p.rolsuper OR p.rolbypassrls) AND pg_has_role(c.oid,p.oid,'SET');
diff --git a/tools/qa/financial-write-matrix.mjs b/tools/qa/financial-write-matrix.mjs
new file mode 100644
--- /dev/null
+++ b/tools/qa/financial-write-matrix.mjs
@@ -0,0 +1,581 @@
+import assert from 'node:assert/strict';
+import { randomUUID, createHash } from 'node:crypto';
+
+export const financialTables = [
+  'contracts',
+  'receivables',
+  'receivable_installments',
+  'payments',
+  'payment_allocations',
+  'payment_reversals',
+  'payment_change_requests',
+  'financial_adjustments',
+  'renegotiations',
+  'expenses',
+  'payment_receipts',
+  'audit_logs',
+];
+
+export function rawRecord(model, row) {
+  return Object.fromEntries(
+    model.fields
+      .filter((f) => f.kind !== 'object' && f.name in row)
+      .map((f) => [f.dbName ?? f.name, JSON.parse(JSON.stringify(row[f.name]))]),
+  );
+}
+
+export function denialKind(status, body) {
+  if (status === 401 && body.code !== '42501') return 'AUTHENTICATION_FAILURE';
+  if (body.code === '42501' && /permission denied for (table|column)/i.test(body.message ?? ''))
+    return 'PRIVILEGE_DENIED';
+  if (body.code === '42501' && /row.level security/i.test(body.message ?? '')) return 'RLS_DENIED';
+  if (status >= 200 && status < 300) return 'WRITE_ACCEPTED';
+  return 'HARNESS_OR_DOMAIN_FAILURE';
+}
+
+// Called only after validateFinancialEnvironment by the existing disposable runner.
+export async function runWriteMatrix({
+  database,
+  Prisma,
+  env,
+  actor,
+  fixture,
+  organizations,
+  check,
+  state,
+  api,
+}) {
+  const owner = await actor(organizations[0]);
+  const f = await fixture(owner);
+  const now = () => new Date();
+  const org = { organizationId: owner.organizationId };
+  const parentMatter = await database.matter.create({
+    data: {
+      ...org,
+      clientId: f.clientId,
+      reference: randomUUID(),
+      title: 'Synthetic identity parent',
+    },
+  });
+  for (const [table, id] of [
+    ['clients', f.clientId],
+    ['matters', parentMatter.id],
+  ]) {
+    for (const payload of [{ id: randomUUID() }, { organization_id: organizations[1] }]) {
+      await check(
+        `INDIRECT-PARENT-${table}-${Object.keys(payload)[0]}`,
+        'Identity cascades cannot mutate financial children',
+        async () => {
+          const person = await actor(organizations[0], 'lawyer');
+          const [before] = await database.$queryRawUnsafe(
+            `SELECT to_jsonb(t)::text AS row FROM public."${table}" t WHERE id=$1::uuid`,
+            id,
+          );
+          const response = await fetch(
+            `${env.NEXT_PUBLIC_SUPABASE_URL}/rest/v1/${table}?id=eq.${id}`,
+            {
+              method: 'PATCH',
+              headers: {
+                apikey: env.NEXT_PUBLIC_SUPABASE_ANON_KEY,
+                Authorization: `Bearer ${person.token}`,
+                'Content-Type': 'application/json',
+              },
+              body: JSON.stringify(payload),
+            },
+          );
+          const body = await response.json();
+          state('attempt', {
+            table,
+            id,
+            payload,
+            http: response.status,
+            code: body.code,
+            message: body.message,
+          });
+          // Tenant movement may be denied by RLS before the identity trigger; both are explicit.
+          assert.ok(['23514', '42501'].includes(body.code));
+          assert.ok(response.status >= 400 && response.status < 500);
+          const [after] = await database.$queryRawUnsafe(
+            `SELECT to_jsonb(t)::text AS row FROM public."${table}" t WHERE id=$1::uuid`,
+            id,
+          );
+          state('before', before);
+          state('after', after);
+          assert.deepEqual(after, before);
+          assert.equal(
+            await database.receivable.count({
+              where: {
+                id: f.receivableId,
+                clientId: f.clientId,
+                organizationId: owner.organizationId,
+              },
+            }),
+            1,
+          );
+        },
+      );
+    }
+  }
+  const paymentData = () => ({
+    ...org,
+    clientId: f.clientId,
+    reference: randomUUID(),
+    amount: '25.00',
+    currency: 'BRL',
+    paidAt: now(),
+    method: 'PIX',
+    status: 'CONFIRMED',
+    confirmedById: owner.userId,
+    confirmedAt: now(),
+    idempotencyKey: randomUUID(),
+    idempotencyHash: 'a'.repeat(64),
+  });
+  const makers = {
+    contracts: async () => ({
+      ...org,
+      clientId: f.clientId,
+      number: randomUUID(),
+      title: 'Synthetic contract',
+      feeModel: 'FIXED',
+    }),
+    receivables: async () => ({
+      ...org,
+      clientId: f.clientId,
+      reference: randomUUID(),
+      description: 'Synthetic debt',
+      originalAmount: '100.00',
+      issueDate: now(),
+      dueDate: now(),
+    }),
+    receivable_installments: async () => {
+      const debt = await database.receivable.create({ data: await makers.receivables() });
+      return { ...org, receivableId: debt.id, sequence: 1, amount: '100.00', dueDate: now() };
+    },
+    payments: async () => paymentData(),
+    payment_allocations: async () => {
+      const payment = await database.payment.create({ data: paymentData() });
+      // Dedicated installment avoids capacity interference between controls.
+      const installment = await database.receivableInstallment.create({
+        data: await makers.receivable_installments(),
+      });
+      return {
+        ...org,
+        paymentId: payment.id,
+        installmentId: installment.id,
+        amount: '25.00',
+        createdById: owner.userId,
+      };
+    },
+    payment_reversals: async () => ({
+      ...org,
+      originalPaymentId: (await database.payment.create({ data: paymentData() })).id,
+      amount: '25.00',
+      reason: 'Synthetic reversal',
+      reversedById: owner.userId,
+    }),
+    payment_change_requests: async () => ({
+      ...org,
+      paymentId: (await database.payment.create({ data: paymentData() })).id,
+      createdById: owner.userId,
+      proposedData: { amount: '20.00' },
+      reason: 'Synthetic correction',
+    }),
+    financial_adjustments: async () => ({
+      ...org,
+      installmentId: f.installmentId,
+      kind: 'DISCOUNT',
+      amount: '1.00',
+      reason: 'Synthetic adjustment',
+      effectiveAt: now(),
+      createdById: owner.userId,
+    }),
+    renegotiations: async () => ({
+      ...org,
+      originalReceivableId: f.receivableId,
+      reason: 'Synthetic renegotiation',
+      createdById: owner.userId,
+    }),
+    expenses: async () => ({
+      ...org,
+      clientId: f.clientId,
+      description: 'Synthetic expense',
+      category: 'QA',
+      amount: '25.00',
+      incurredAt: now(),
+      createdById: owner.userId,
+    }),
+    payment_receipts: async () => {
+      const doc = await database.document.create({
+        data: {
+          ...org,
+          clientId: f.clientId,
+          installmentId: f.installmentId,
+          title: 'Synthetic evidence',
+          createdById: owner.userId,
+        },
+      });
+      await database.documentVersion.create({
+        data: {
+          ...org,
+          documentId: doc.id,
+          version: 1,
+          storageKey: `organizations/${owner.organizationId}/documents/${doc.id}/synthetic.pdf`,
+          fileName: 'synthetic.pdf',
+          mimeType: 'application/pdf',
+          sizeBytes: 1n,
+          sha256: 'a'.repeat(64),
+          uploadedById: owner.userId,
+        },
+      });
+      return {
+        ...org,
+        clientId: f.clientId,
+        documentId: doc.id,
+        installmentId: f.installmentId,
+        sha256: createHash('sha256').update(randomUUID()).digest('hex'),
+        submittedById: owner.userId,
+      };
+    },
+    audit_logs: async () => ({
+      ...org,
+      actorUserId: owner.userId,
+      action: 'CREATE',
+      resource: 'synthetic_matrix',
+      resourceId: randomUUID(),
+    }),
+  };
+  const models = new Map(Prisma.dmmf.datamodel.models.map((m) => [m.dbName, m]));
+  const updates = {
+    contracts: { fixed_amount: '200.00' },
+    receivables: { original_amount: '200.00' },
+    receivable_installments: { amount: '200.00' },
+    payments: { status: 'REVERSED' },
+    payment_allocations: { reversed_at: new Date().toISOString(), reversed_by_id: owner.userId },
+    payment_reversals: { reason: 'Forbidden history rewrite' },
+    payment_change_requests: {
+      status: 'APPROVED',
+      reviewed_by_id: owner.userId,
+      reviewed_at: new Date().toISOString(),
+    },
+    financial_adjustments: { approved_by_id: owner.userId, approved_at: new Date().toISOString() },
+    renegotiations: { status: 'APPROVED' },
+    expenses: { status: 'PAID', paid_at: new Date().toISOString() },
+    payment_receipts: { status: 'CONFIRMED' },
+    audit_logs: { action: 'REVERSE' },
+  };
+  const fixtures = new Map();
+  for (const table of financialTables) {
+    const model = models.get(table);
+    assert.ok(model, `Unknown model ${table}`);
+    const delegate = model.name[0].toLowerCase() + model.name.slice(1);
+    const target = await database[delegate].create({ data: await makers[table]() });
+    const data = await makers[table]();
+    let insert;
+    const rollback = new Error('Synthetic insert control rollback');
+    await assert.rejects(
+      database.$transaction(async (tx) => {
+        const row = await tx[delegate].create({ data });
+        insert = rawRecord(model, row);
+        throw rollback;
+      }),
+      (e) => e === rollback,
+    );
+    assert.ok(insert && target.id);
+    // Prove the exact JSON payload also satisfies PostgreSQL, not just Prisma input.
+    await assert.rejects(
+      database.$transaction(async (tx) => {
+        await tx.$executeRawUnsafe(
+          `INSERT INTO public."${table}" SELECT * FROM jsonb_populate_record(NULL::public."${table}", $1::jsonb)`,
+          JSON.stringify(insert),
+        );
+        throw rollback;
+      }),
+      (e) => e === rollback,
+    );
+    fixtures.set(table, { target: rawRecord(model, target), insert });
+  }
+  const snapshot = async () => {
+    const result = {};
+    for (const table of [
+      ...financialTables,
+      'documents',
+      'document_versions',
+      'organizations',
+      'organization_members',
+      'organization_member_roles',
+      'roles',
+      'role_permissions',
+      'users',
+    ]) {
+      const filter = table === 'organizations' ? 'id' : 'organization_id';
+      const [row] = await database.$queryRawUnsafe(
+        `SELECT coalesce(jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text),'[]'::jsonb)::text AS rows FROM public."${table}" t WHERE ${filter}=$1::uuid`,
+        owner.organizationId,
+      );
+      result[table] = {
+        sha256: createHash('sha256').update(row.rows).digest('hex'),
+        rowCount: JSON.parse(row.rows).length,
+      };
+    }
+    return result;
+  };
+  // A custom role may hold granular manage permissions without being administrator.
+  // The API denies that role; Data API must not let it assign the official admin role.
+  const customKey = `qa-custom-${randomUUID()}`;
+  const customRole = await database.role.create({
+    data: { ...org, key: customKey, name: 'Synthetic custom manager' },
+  });
+  const permissions = await database.permission.findMany({
+    where: {
+      ...org,
+      OR: [
+        { resource: 'users', action: 'manage' },
+        { resource: 'roles', action: 'manage' },
+        { resource: 'organization', action: 'update' },
+      ],
+    },
+  });
+  assert.equal(permissions.length, 3);
+  for (const permission of permissions)
+    await database.rolePermission.create({
+      data: { ...org, roleId: customRole.id, permissionId: permission.id },
+    });
+  const custom = await actor(organizations[0], customKey);
+  const adminRole = await database.role.findUniqueOrThrow({
+    where: { organizationId_key: { organizationId: owner.organizationId, key: 'administrator' } },
+  });
+  await check(
+    'INDIRECT-CUSTOM-ROLE',
+    'Granular manager cannot self-promote through memberships',
+    async () => {
+      assert.equal(
+        (
+          await api(custom, '/finance/expenses/approval-policy', {
+            method: 'PATCH',
+            body: { required: false },
+          })
+        ).status,
+        403,
+        'Official administrator check must remain active',
+      );
+      const payload = {
+        organization_id: owner.organizationId,
+        membership_id: custom.membershipId,
+        role_id: adminRole.id,
+      };
+      const sentinel = new Error('Rollback valid membership insert');
+      await assert.rejects(
+        database.$transaction(async (tx) => {
+          await tx.organizationMemberRole.create({
+            data: { ...org, membershipId: custom.membershipId, roleId: adminRole.id },
+          });
+          throw sentinel;
+        }),
+        (e) => e === sentinel,
+      );
+      const before = await snapshot();
+      state('before', before);
+      const response = await fetch(
+        `${env.NEXT_PUBLIC_SUPABASE_URL}/rest/v1/organization_member_roles`,
+        {
+          method: 'POST',
+          headers: {
+            apikey: env.NEXT_PUBLIC_SUPABASE_ANON_KEY,
+            Authorization: `Bearer ${custom.token}`,
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify(payload),
+        },
+      );
+      const body = await response.json();
+      state('attempt', {
+        http: response.status,
+        code: body.code,
+        message: body.message,
+        payload,
+        profileId: custom.profileId,
+      });
+      const after = await snapshot();
+      state('after', after);
+      assert.deepEqual(after, before);
+      assert.equal(denialKind(response.status, body), 'PRIVILEGE_DENIED');
+    },
+  );
+  for (const role of ['administrator', 'lawyer', 'secretary', 'finance', 'client', 'anon']) {
+    const person =
+      role === 'anon'
+        ? null
+        : await actor(organizations[0], role, role === 'client' ? f.clientId : undefined);
+    if (person) {
+      const response = await fetch(`${env.NEXT_PUBLIC_SUPABASE_URL}/auth/v1/user`, {
+        headers: {
+          apikey: env.NEXT_PUBLIC_SUPABASE_ANON_KEY,
+          Authorization: `Bearer ${person.token}`,
+        },
+      });
+      assert.equal(response.status, 200, 'Auth precondition');
+      assert.equal((await response.json()).id, person.profileId);
+      const membership = await database.organizationMember.findUniqueOrThrow({
+        where: { id: person.membershipId },
+      });
+      assert.equal(membership.organizationId, owner.organizationId);
+      assert.equal(membership.status, 'ACTIVE');
+    }
+    if (person)
+      for (const table of [
+        'organizations',
+        'users',
+        'roles',
+        'permissions',
+        'role_permissions',
+        'organization_members',
+        'organization_member_roles',
+        'documents',
+        'document_versions',
+      ]) {
+        await check(
+          `INDIRECT-${role}-${table}`,
+          'Auxiliary writes cannot change configuration, authorization or evidence',
+          async () => {
+            const model = models.get(table);
+            const filter = table === 'organizations' ? 'id' : 'organization_id';
+            const [row] = await database.$queryRawUnsafe(
+              `SELECT to_jsonb(t)::text AS data FROM public."${table}" t WHERE ${filter}=$1::uuid LIMIT 1`,
+              owner.organizationId,
+            );
+            // Empty targets are harness failures, never a security PASS.
+            assert.ok(row, `Missing indirect target ${table}`);
+            const target = JSON.parse(row.data);
+            const keys = model.fields.filter((f) => f.isId).map((f) => f.dbName ?? f.name);
+            if (!keys.length)
+              for (const field of model.primaryKey.fields)
+                keys.push(model.fields.find((f) => f.name === field).dbName ?? field);
+            const query = keys.map((key) => `${key}=eq.${target[key]}`).join('&');
+            const payload =
+              table === 'organizations'
+                ? { settings: { ...target.settings, expenseApprovalRequired: false } }
+                : { [keys[0]]: target[keys[0]] };
+            const before = await snapshot();
+            state('before', before);
+            const response = await fetch(
+              `${env.NEXT_PUBLIC_SUPABASE_URL}/rest/v1/${table}?${query}`,
+              {
+                method: 'PATCH',
+                headers: {
+                  apikey: env.NEXT_PUBLIC_SUPABASE_ANON_KEY,
+                  Authorization: `Bearer ${person.token}`,
+                  'Content-Type': 'application/json',
+                },
+                body: JSON.stringify(payload),
+              },
+            );
+            const body = await response.json();
+            state('attempt', {
+              http: response.status,
+              code: body.code,
+              message: body.message,
+              payload,
+              target,
+            });
+            const after = await snapshot();
+            state('after', after);
+            assert.deepEqual(after, before);
+            assert.equal(denialKind(response.status, body), 'PRIVILEGE_DENIED');
+          },
+        );
+      }
+    await check(
+      `RLS-READ-${role}`,
+      'Authorized own payment and cross-organization isolation',
+      async () => {
+        const target = fixtures.get('payments').target;
+        const headers = {
+          apikey: env.NEXT_PUBLIC_SUPABASE_ANON_KEY,
+          ...(person ? { Authorization: `Bearer ${person.token}` } : {}),
+        };
+        const own = await fetch(
+          `${env.NEXT_PUBLIC_SUPABASE_URL}/rest/v1/payments?id=eq.${target.id}&select=id`,
+          { headers },
+        );
+        const body = await own.json();
+        state('ownRead', { http: own.status, body });
+        if (!person) {
+          assert.equal(body.code, '42501');
+          return;
+        }
+        assert.equal(own.status, 200);
+        assert.equal(body.length, ['administrator', 'finance', 'client'].includes(role) ? 1 : 0);
+        const other = await database.payment.findFirst({
+          where: { organizationId: organizations[1] },
+        });
+        assert.ok(other, 'Cross-organization payment must exist');
+        const cross = await fetch(
+          `${env.NEXT_PUBLIC_SUPABASE_URL}/rest/v1/payments?id=eq.${other.id}&select=id`,
+          { headers },
+        );
+        const crossBody = await cross.json();
+        state('crossRead', { http: cross.status, body: crossBody });
+        assert.equal(cross.status, 200);
+        assert.deepEqual(crossBody, []);
+      },
+    );
+    for (const table of financialTables)
+      for (const method of ['POST', 'PATCH', 'DELETE']) {
+        await check(
+          `RLS-WRITE-${role}-${table}-${method}`,
+          'Valid payload, existing target, authorization boundary',
+          async () => {
+            const { target, insert } = fixtures.get(table);
+            const [existing] = await database.$queryRawUnsafe(
+              `SELECT id FROM public."${table}" WHERE id=$1::uuid`,
+              target.id,
+            );
+            assert.equal(existing.id, target.id);
+            const before = await snapshot();
+            state('before', before);
+            const response = await fetch(
+              `${env.NEXT_PUBLIC_SUPABASE_URL}/rest/v1/${table}${method === 'POST' ? '' : `?id=eq.${target.id}`}`,
+              {
+                method,
+                signal: AbortSignal.timeout(15000),
+                headers: {
+                  apikey: env.NEXT_PUBLIC_SUPABASE_ANON_KEY,
+                  ...(person ? { Authorization: `Bearer ${person.token}` } : {}),
+                  'Content-Type': 'application/json',
+                  Prefer: 'return=representation',
+                },
+                ...(method === 'DELETE'
+                  ? {}
+                  : { body: JSON.stringify(method === 'POST' ? insert : updates[table]) }),
+              },
+            );
+            const body = await response.json();
+            const kind = denialKind(response.status, body);
+            state('targetBefore', target);
+            state('attempt', {
+              role,
+              profileId: person?.profileId,
+              organizationId: owner.organizationId,
+              table,
+              method,
+              targetId: target.id,
+              payload: method === 'POST' ? insert : method === 'PATCH' ? updates[table] : null,
+              http: response.status,
+              code: body.code,
+              message: body.message,
+              kind,
+            });
+            const after = await snapshot();
+            state('after', after);
+            assert.deepEqual(after, before, 'No table, history or indirect effect');
+            assert.equal(
+              kind,
+              'PRIVILEGE_DENIED',
+              'RLS/domain/invalid token/zero rows cannot masquerade as ACL denial',
+            );
+            assert.ok(response.status >= 400 && response.status < 500);
+          },
+        );
+      }
+  }
+}
diff --git a/tools/qa/financial-security-ci.mjs b/tools/qa/financial-security-ci.mjs
new file mode 100644
--- /dev/null
+++ b/tools/qa/financial-security-ci.mjs
@@ -0,0 +1,140 @@
+import assert from 'node:assert/strict';
+import { financialTables } from './financial-write-matrix.mjs';
+
+export const dependencyTables = [
+  'organizations',
+  'users',
+  'roles',
+  'permissions',
+  'role_permissions',
+  'user_roles',
+  'organization_members',
+  'organization_member_roles',
+  'documents',
+  'document_versions',
+];
+
+export async function inspectFinancialSecurity(database, record = () => {}) {
+  const role = await database.$queryRawUnsafe(
+    `SELECT current_user::text AS name, current_setting('server_version_num') AS version, r.rolsuper,r.rolbypassrls FROM pg_roles r WHERE rolname=current_user`,
+  );
+  assert.equal(
+    Math.floor(Number(role[0].version) / 10000),
+    17,
+    'Expected disposable PostgreSQL 17',
+  );
+  assert.ok(
+    role[0].rolsuper || role[0].rolbypassrls,
+    'API role must keep its existing FORCE RLS contract',
+  );
+  const result = { role, tables: [] };
+  for (const table of [...financialTables, ...dependencyTables]) {
+    const [relation] = await database.$queryRawUnsafe(
+      `SELECT c.relowner::regrole::text AS owner,c.relrowsecurity,c.relforcerowsecurity,c.relacl::text FROM pg_class c WHERE c.oid=to_regclass($1)`,
+      `public.${table}`,
+    );
+    assert.ok(relation?.relrowsecurity && relation.relforcerowsecurity, table);
+    const [apiAcl] = await database.$queryRawUnsafe(
+      `SELECT has_table_privilege(current_user,$1,'SELECT') AS read,has_table_privilege(current_user,$1,'INSERT') AS insert,has_table_privilege(current_user,$1,'UPDATE') AS update,has_table_privilege(current_user,$1,'DELETE') AS delete`,
+      `public.${table}`,
+    );
+    assert.ok(
+      Object.values(apiAcl).every(Boolean),
+      `API role lacks a required table privilege: ${table}`,
+    );
+    const acl = await database.$queryRawUnsafe(
+      `SELECT r.rolname,has_table_privilege(r.oid,$1,'SELECT') AS read,has_table_privilege(r.oid,$1,'INSERT,UPDATE,DELETE') AS write,has_any_column_privilege(r.oid,$1,'INSERT,UPDATE') AS column_write FROM pg_roles r WHERE r.rolname IN ('anon','authenticated')`,
+      `public.${table}`,
+    );
+    assert.equal(acl.length, 2);
+    assert.ok(
+      acl.every((r) => !r.write && !r.column_write),
+      `Remaining inherited/column DML: ${table}`,
+    );
+    const policies = await database.$queryRawUnsafe(
+      `SELECT policyname,permissive,roles::text,cmd,qual,with_check FROM pg_policies WHERE schemaname='public' AND tablename=$1`,
+      table,
+    );
+    for (const cmd of ['INSERT', 'UPDATE', 'DELETE'])
+      assert.ok(
+        policies.some(
+          (p) =>
+            p.cmd === cmd &&
+            p.permissive === 'RESTRICTIVE' &&
+            p.policyname.startsWith('financial_api_'),
+        ),
+        `${table}: ${cmd}`,
+      );
+    assert.ok(!policies.some((p) => p.cmd === 'ALL' && p.policyname.startsWith('financial_api_')));
+    const triggers = await database.$queryRawUnsafe(
+      `SELECT tgname,tgenabled,pg_get_triggerdef(oid) AS definition FROM pg_trigger WHERE tgrelid=to_regclass($1) AND NOT tgisinternal`,
+      `public.${table}`,
+    );
+    assert.ok(
+      triggers.every((t) => t.tgenabled !== 'D'),
+      'Integrity trigger disabled',
+    );
+    const constraints = await database.$queryRawUnsafe(
+      `SELECT conname,pg_get_constraintdef(oid) AS definition FROM pg_constraint WHERE conrelid=to_regclass($1)`,
+      `public.${table}`,
+    );
+    result.tables.push({ table, ...relation, apiAcl, acl, policies, triggers, constraints });
+    record(result);
+  }
+  result.escalation = await database.$queryRawUnsafe(
+    `SELECT c.rolname AS client,p.rolname AS privileged FROM pg_roles c CROSS JOIN pg_roles p WHERE c.rolname IN ('anon','authenticated') AND (p.rolsuper OR p.rolbypassrls) AND pg_has_role(c.oid,p.oid,'SET')`,
+  );
+  assert.equal(result.escalation.length, 0, 'Client can SET ROLE to a privileged identity');
+  result.parentGuards = await database.$queryRawUnsafe(
+    `SELECT tgrelid::regclass::text AS relation,tgname,tgenabled,pg_get_triggerdef(oid) AS definition FROM pg_trigger WHERE tgname IN ('protect_financial_client_identity','protect_financial_matter_identity')`,
+  );
+  assert.equal(result.parentGuards.length, 2);
+  assert.ok(result.parentGuards.every((t) => t.tgenabled !== 'D'));
+  result.storagePolicies = await database.$queryRawUnsafe(
+    `SELECT policyname,permissive,cmd,qual,with_check FROM pg_policies WHERE schemaname='storage' AND tablename='objects' AND policyname IN ('financial_evidence_update','financial_evidence_delete')`,
+  );
+  assert.equal(result.storagePolicies.length, 2);
+  assert.ok(
+    result.storagePolicies.every(
+      (p) => p.permissive === 'RESTRICTIVE' && ['UPDATE', 'DELETE'].includes(p.cmd),
+    ),
+  );
+  const [helperOwner] = await database.$queryRawUnsafe(
+    `SELECT r.rolname,r.rolsuper,r.rolbypassrls FROM pg_proc p JOIN pg_roles r ON r.oid=p.proowner WHERE p.oid='public.is_financial_storage_object(text)'::regprocedure`,
+  );
+  assert.ok(
+    helperOwner.rolsuper || helperOwner.rolbypassrls,
+    'Storage linkage helper must see FORCE RLS evidence',
+  );
+  result.helperOwner = helperOwner;
+  result.memberships = await database.$queryRawUnsafe(
+    `SELECT roleid::regrole::text AS parent,member::regrole::text AS member,inherit_option,set_option FROM pg_auth_members`,
+  );
+  result.defaults = await database.$queryRawUnsafe(
+    `SELECT defaclrole::regrole::text AS owner,defaclnamespace::regnamespace::text AS schema,defaclobjtype,defaclacl::text FROM pg_default_acl`,
+  );
+  result.views = await database.$queryRawUnsafe(
+    `SELECT c.relname,c.relkind,CASE WHEN c.relkind IN ('v','m') THEN pg_get_viewdef(c.oid,true) ELSE NULL END AS definition FROM pg_class c WHERE c.relnamespace='public'::regnamespace AND c.relkind IN ('v','m','f')`,
+  );
+  result.functions = await database.$queryRawUnsafe(
+    `SELECT p.proname,pg_get_functiondef(p.oid) AS definition,p.proconfig::text,p.proowner::regrole::text AS owner,p.prosecdef,p.prorettype::regtype::text AS returns,p.proacl::text,has_function_privilege('authenticated',p.oid,'EXECUTE') AS authenticated_execute FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='public' AND p.prokind='f' ORDER BY p.proname`,
+  );
+  const allowedDefiners = [
+    'handle_auth_user_profile',
+    'current_organization_ids',
+    'has_permission',
+    'current_client_id',
+    'can_access_client_resource',
+    'can_download_storage_object',
+    'is_financial_storage_object',
+  ];
+  assert.ok(
+    result.functions
+      .filter((f) => f.prosecdef && f.authenticated_execute && f.returns !== 'trigger')
+      .every((f) => allowedDefiners.includes(f.proname)),
+    'Unreviewed executable SECURITY DEFINER',
+  );
+  assert.equal(result.views.length, 0, 'New public view requires explicit write-path review');
+  record(result);
+  return result;
+}
