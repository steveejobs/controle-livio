# Aplicacoes
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-local-anon-key
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Limites por usuário/organização, compartilhados pelas instâncias da API.
API_RATE_LIMIT_READ=300
API_RATE_LIMIT_WRITE=60

# Mesmo banco do projeto Supabase usado pela API/Prisma. Nao use PostgreSQL externo.
# Em Vercel/serverless, use o Transaction pooler (Supavisor, porta 6543) com
# `pgbouncer=true&connection_limit=1`; reserve a conexao direta para ferramentas administrativas.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Conexao de sessao para migrations remotas; nunca use a URL de transaction pooler aqui.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_ENVIRONMENT=development
SUPABASE_PROJECT_REF=example-project-ref
CONFIRM_SUPABASE_PROJECT_REF=example-project-ref
SUPABASE_LOCAL=true
ALLOW_PRODUCTION_MIGRATION=false

# Supabase Auth e Storage exclusivamente server-side.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=example-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=example-service-role-key-never-expose-to-web
SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/auth/confirm
STORAGE_BUCKET=legal-documents
MAX_DOCUMENT_SIZE_MB=4
# Configure a private ClamAV daemon host in staging/production before enabling uploads.
# CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
# Segredo de no mínimo 32 caracteres enviado pela Vercel Cron no header Authorization.
# CRON_SECRET=replace-with-a-random-secret

# Push nativo em celulares e computadores (gere com `npx web-push generate-vapid-keys`).
# Configure o trio completo somente na API; nunca exponha a chave privada ao app web.
# VAPID_PUBLIC_KEY=replace-with-the-generated-public-key
# VAPID_PRIVATE_KEY=replace-with-the-generated-private-key
# VAPID_SUBJECT=mailto:suporte@example.com

# E-mail opcional
# SMTP_HOST=smtp.example.test
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=example-user
# SMTP_PASSWORD=example-password
# SMTP_FROM=no-reply@example.test
TRUST_PROXY=false

# Bootstrap administrativo. Valores devem ser fornecidos fora do Git.
ALLOW_REMOTE_BOOTSTRAP=false
ALLOW_PRODUCTION_BOOTSTRAP=false
BOOTSTRAP_ORGANIZATION_SLUG=example-organization
BOOTSTRAP_ORGANIZATION_NAME=Example Organization
BOOTSTRAP_ADMIN_NAME=Example Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
