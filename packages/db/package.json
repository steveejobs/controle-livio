{
  "name": "@livio/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --maxWorkers=1 --no-file-parallelism",
    "db:generate": "npm --prefix ../.. run db:generate",
    "db:format": "prisma format --config ../../prisma.config.ts",
    "db:validate": "prisma validate --config ../../prisma.config.ts",
    "db:migrate:dev": "npm --prefix ../.. run db:migrate:dev",
    "db:migrate:deploy": "npm --prefix ../.. run db:migrate:deploy",
    "db:migrate:status": "npm --prefix ../.. run db:migrate:status",
    "db:studio": "npm --prefix ../.. run db:studio",
    "db:seed": "npm --prefix ../.. run db:seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@livio/shared": "*",
    "@prisma/internals": "7.10.1",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "vitest": "^4.1.12"
  }
}
