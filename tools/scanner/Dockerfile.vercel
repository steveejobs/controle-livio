FROM node:24.22.3-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 AS node
FROM clamav/clamav:1.5.4-debian13-slim@sha256:6982509b9e1415bf23cb49d0c55872fdd57fd2b92be33fa26d487da42d322076

COPY --from=node /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY gateway.mjs vercel-entrypoint.mjs signature-header.mjs clamd-vercel.conf freshclam-vercel.conf ./
RUN node --version && clamd --version && chown -R clamav:clamav /var/lib/clamav
USER clamav
ENV PORT=8080 TMPDIR=/tmp
EXPOSE 8080
HEALTHCHECK NONE
ENTRYPOINT ["node", "vercel-entrypoint.mjs"]
