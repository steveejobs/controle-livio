# Copy to a private location outside the repository. Do not print resolved compose configuration.
# Example hostname: scanner.your-domain.com (DNS must point to the scanner host).
SCANNER_DOMAIN=
# Generate with: node -p "require('node:crypto').randomBytes(32).toString('hex')"
SCANNER_TOKEN=
# Safe default: local access only. Explicitly select 0.0.0.0 to serve public HTTPS.
SCANNER_BIND_ADDRESS=127.0.0.1
SCANNER_HTTPS_PORT=443
