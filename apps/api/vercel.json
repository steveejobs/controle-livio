{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nestjs",
  "git": {
    "deploymentEnabled": {
      "validation/gha-ci-20261029": false
    }
  },
  "installCommand": "cd ../.. && npm ci --include=dev",
  "buildCommand": "cd ../.. && npm run build:api",
  "regions": ["cle1"],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=86400" }]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://controle-livio-web.vercel.app",
      "permanent": true
    }
  ],
  "crons": [
    { "path": "/v1/notifications/cron", "schedule": "0 11 * * *" },
    { "path": "/v1/notifications/access-alerts/cron", "schedule": "*/5 * * * *" }
  ],
  "fluid": true
}
