{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nestjs",
  "git": {
    "deploymentEnabled": {
      "fix/runtime-security-20261122": false,
      "validation/gha-ci-20261029": false,
      "validation/audit-stage2-20261104": false
    }
  },
  "installCommand": "cd ../.. && npm ci --include=dev",
  "buildCommand": "cd ../.. && npm run build:api && npm run release:environment",
  "regions": ["cle1"],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=86400" }]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://controle-livio-web.vercel.app",
      "permanent": true
    }
  ],
  "crons": [{ "path": "/v1/notifications/cron", "schedule": "0 11 * * *" }],
  "fluid": true
}
